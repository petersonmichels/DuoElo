{
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "js/ts.validate.enabled": true,
  "js/ts.tsc.autoDetect": "off",
  "search.exclude": {
    "**/node_modules": true,
    "**/functions/node_modules": true,
    "**/lib": true,
    "**/.expo": true,
    "**/android": true,
    "**/ios": true
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/lib": true,
    "**/.expo": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/functions/node_modules/**": true,
    "**/lib/**": true,
    "**/.expo/**": true
  }
}