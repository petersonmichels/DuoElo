{
  "cli": {
    "version": ">= 21.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.13.0",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "22.13.0",
      "ios": {
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "appl_xZNigunYBjnJfNUXAOfFqIyXbgY",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_KEY": "goog_bYcEfvvHdSDOOPlWDlhsnYxJJov"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "node": "22.13.0",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "appl_xZNigunYBjnJfNUXAOfFqIyXbgY",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_KEY": "goog_bYcEfvvHdSDOOPlWDlhsnYxJJov"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "appleId": "peterson.michels@gmail.com",
        "ascAppId": "6806007810"
      }
    },
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {
        "appleId": "peterson.michels@gmail.com",
        "ascAppId": "6806007810"
      }
    }
