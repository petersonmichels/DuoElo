rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔒 FUNÇÕES AUXILIARES DE SEGURANÇA
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 🔒 PERMITE QUE O PARCEIRO ATIVE O STATUS PREMIUM DO OUTRO NO PLANO DUO
    function isPartnerUpdatingPremium() {
      let data = request.resource.data;
      let affected = data.diff(resource.data).affectedKeys();
      
      return isAuthenticated()
        && resource.data.partnerId == request.auth.uid
        && affected.hasOnly(['isPremium', 'isPartnerPremium', 'planType'])
        && (data.isPremium is bool)
        && (data.isPartnerPremium is bool)
        && (data.planType is string);
    }

    // 🔒 VALIDAÇÃO ESTRITA DE TIPOS E CAMPOS PERMITIDOS NO MATCH DE CASAIS
    function isUpdatingMatchData() {
      let data = request.resource.data;
      let affected = data.diff(resource.data).affectedKeys();
      
      return isAuthenticated()
        // 1. Restringe a alteração APENAS às chaves do fluxo de Match
        && affected.hasOnly(['pendingMatchRequest', 'sentMatchRequestTo', 'partnerId', 'isSoloMode', 'matchStatus'])
        
        // 2. Validação estrita dos tipos de dados enviados
        && (data.matchStatus in ['pending', 'accepted', 'declined', 'none'])
        && (data.partnerId is string || data.partnerId == null)
        && (data.sentMatchRequestTo is string || data.sentMatchRequestTo == null)
        && (data.pendingMatchRequest is string || data.pendingMatchRequest == null)
        && (data.isSoloMode is bool);
    }

    // 👤 PERFIL DO USUÁRIO & SUBCOLEÇÕES PRIVADAS
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, delete: if isOwner(userId);
      // Permite alterar se for o próprio dono, se for convite/aceite de match, ou se for o parceiro ativando o Plano Duo
      allow update: if isOwner(userId) || isUpdatingMatchData() || isPartnerUpdatingPremium();

      // 🔔 SUBCOLEÇÃO DE NOTIFICAÇÕES (Dono lê/apaga; parceiros criam)
      match /notifications/{notificationId} {
        allow read, delete: if isOwner(userId);
        allow create: if isAuthenticated() 
          && request.resource.data.title is string 
          && request.resource.data.body is string;
        allow update: if false;
      }

      // 🎁 SUBCOLEÇÕES DA LOJA
      match /shop/{document=**} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // 📔 SUBCOLEÇÃO DE DIÁRIOS (100% Privado)
      match /journals/{journalId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 💑 CASAIS E JORNADA SINCRONIZADA (Isolamento por Membros do Casal)
    match /couples/{coupleId} {
      allow read, update: if isAuthenticated() && (request.auth.uid in resource.data.partners);
      allow create: if isAuthenticated();
    }

    match /couples/{coupleId}/{allSubcollections=**} {
      allow read, write: if isAuthenticated() && 
        (request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.partners);
    }

    // 📚 CONTEÚDOS PÚBLICOS E ANAMNESE (Somente Leitura para Usuários)
    match /courses/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /anamnesis/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /questions/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /tasks/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /weeks/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /weekly_challenges/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /catalog/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // 🛡️ COLEÇÃO DE AUDITORIA (AUDIT_LOGS - Permitir escrita logada ou apenas Admin)
    match /audit_logs/{logId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }

    // 🛑 BLOQUEIO PADRÃO (Deny All)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}