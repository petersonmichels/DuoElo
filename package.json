{
  "name": "duoelo",
  "version": "1.0.3",
  "main": "expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "doctor": "npx expo-doctor",
    "type-check": "tsc --noEmit",
    "security-check": "npm audit --audit-level=high",
    "test": "jest",
    "test:pentest": "firebase emulators:exec --only firestore \"jest __tests__/security_rules.test.js\"",
    "test:flow": "jest __tests__/e2e_business_flow.test.js --runInBand",
    "test:e2e": "detox test -c ios.sim.debug",
    "validate-app": "npm run type-check && npm run lint && npm run security-check",
    "check-build": "npx expo-doctor && npx expo prebuild --clean",
    "build:ios": "npm run validate-app && npm run check-build && git add . && (git commit -m 'build: versao 1.0.3 ios validada' || true) && git push origin main && eas build --platform ios --auto-submit",
    "build:android": "npm run validate-app && npm run check-build && git add . && (git commit -m 'build: versao 1.0.3 android validada' || true) && git push origin main && eas build --platform android --auto-submit"
  },
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/ui": "~57.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "dotenv": "^17.4.2",
    "expo": "~57.0.21",
    "expo-apple-authentication": "~57.0.1",
    "expo-audio": "~57.0.4",
    "expo-auth-session": "~57.0.11",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.17",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "firebase": "^11.10.0",
    "i18next": "^26.4.2",
    "lottie-react-native": "~7.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.13",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-purchases": "^10.9.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.4",
    "detox": "^20.51.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-native": "^5.0.0",
    "expo-module-scripts": "^56.0.3",
    "jest": "^29.7.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "stream-json": "^3.4.1"
  }
}
