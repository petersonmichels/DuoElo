{
  "name": "duoelo",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "doctor": "npx expo-doctor",
    "check-build": "npx expo-doctor && npx expo prebuild --clean",
    "build:ios": "npm run check-build && git add . && git commit -m 'build: versao ios validada' && git push origin main && eas build --platform ios --profile production",
    "build:android": "npm run check-build && git add . && git commit -m 'build: versao android validada' && git push origin main && eas build --platform android --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo/metro-runtime": "~57.0.14",
    "@expo/ui": "~57.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "dotenv": "^17.4.2",
    "expo": "~57.0.17",
    "expo-apple-authentication": "~57.0.1",
    "expo-auth-session": "~57.0.10",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.15",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "firebase": "^11.10.0",
    "lottie-react-native": "~7.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
